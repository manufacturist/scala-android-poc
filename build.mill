//| mill-version: 1.3.1
//| mill-jvm-version: zulu:21
//| mvnDeps:
//| - org.ow2.asm:asm:9.8
package build

import mill.*
import mill.androidlib.*
import mill.scalalib.*
import millbuild.{LayoutBindings, ScalaLambdaFix}

object androidSdkModule0 extends AndroidSdkModule {
  def buildToolsVersion = "35.0.0"

  // android.jar holds stubs only. IntelliJ attaches sources to a jar when they sit next to it as
  // <name>-sources.jar, so copy android.jar into Task.dest and pack the SDK's sources/android-NN
  // (installed by sdkmanager) beside it.
  def androidPlatformJars: T[PlatformJars] = Task {
    val sdkJar     = androidSdk().androidJar.path
    val platform   = sdkJar / os.up
    val sources    = platform / os.up / os.up / "sources" / platform.last
    os.copy.over(sdkJar, Task.dest / "android.jar")
    val sourcesJar = Option.when(os.exists(sources)) {
      os.zip(Task.dest / "android-sources.jar", Seq(sources))
      PathRef(Task.dest / "android-sources.jar")
    }
    PlatformJars(PathRef(Task.dest / "android.jar"), sourcesJar)
  }

  override def androidJarPath: T[PathRef] = Task(androidPlatformJars().jar)

  def androidSourcesJar: T[Option[PathRef]] = Task(androidPlatformJars().sources)
}

final case class PlatformJars(jar: PathRef, sources: Option[PathRef]) derives upickle.default.ReadWriter

object app extends AndroidAppScalaModule {
  def scalaVersion                = "3.10.0"
  def androidSdkModule            = mill.api.ModuleRef(androidSdkModule0)
  // Scala 3.8+ lazy vals (stdlib included) use java.lang.invoke.VarHandle, which Android has from API 33.
  def androidMinSdk               = 33
  def androidCompileSdk           = 35
  def androidApplicationId        = "dev.typelevel.hello"
  def androidApplicationNamespace = "dev.typelevel.hello"

  def mvnDeps = Task {
    Seq(
      mvn"org.typelevel::cats-effect:3.7.1",
      mvn"co.fs2::fs2-core:3.14.0",
      mvn"androidx.appcompat:appcompat:1.8.0",
      mvn"com.google.android.material:material:1.14.0",
      // Since 3.8 the stdlib ships as scala-library and scala3-library_3 is an empty shim. Pin the shim,
      // or libraries built on 3.3 drag in the old one and d8 rejects the duplicate classes.
      mvn"org.scala-lang:scala3-library_3:${scalaVersion()}"
    )
  }

  // Mill's AndroidModule reports only AAR sources to IDEs over BSP. Add the source jars of plain
  // jar dependencies so IntelliJ shows library sources and Scaladoc instead of decompiled TASTy.
  override def bspMvnDependencySources: T[Seq[PathRef]] = Task {
    super.bspMvnDependencySources() ++
      defaultResolver().classpath(mandatoryMvnDeps() ++ mvnDeps(), sources = true) ++
      androidSdkModule0.androidSourcesJar()
  }

  // Typed bindings for res/layout*/*.xml, one final class per layout. See mill-build/src/LayoutBindings.scala.
  def layoutBindings: T[PathRef] = Task {
    LayoutBindings.generate(androidResources().map(_.path), androidApplicationNamespace(), Task.dest)
    PathRef(Task.dest)
  }

  override def generatedSources: T[Seq[PathRef]] = Task {
    super.generatedSources() :+ layoutBindings()
  }

  // Dependency jars built with older Scala 3 compilers dex into lambdas ART refuses to load;
  // patch them before d8 runs. See mill-build/src/ScalaLambdaFix.scala.
  override def androidPackagedDeps: T[Seq[PathRef]] = Task {
    super.androidPackagedDeps().zipWithIndex.map { (jar, i) =>
      ScalaLambdaFix.patchJar(jar.path, Task.dest / s"$i-${jar.path.last}").fold(jar)(PathRef(_))
    }
  }

  // JVM unit tests in app/src/test/scala. android.* classes are stubs here, so test code that avoids them.
  object test extends AndroidAppScalaTests, TestModule.Weaver {
    def weaverVersion = "0.13.0"
    def mvnDeps       = Seq(mvn"org.typelevel::cats-effect-testkit:3.7.1")
  }

  // Instrumented tests in app/src/androidTest/scala. They run inside the app process on a device or emulator.
  // TestModule.Weaver is not mixed in: Mill writes testFramework into the test manifest as the instrumentation runner.
  object androidTest extends AndroidAppScalaInstrumentedTests {
    def mvnDeps = Seq(
      mvn"org.typelevel::weaver-cats:0.13.0",
      mvn"androidx.test:runner:1.7.0",
      mvn"androidx.test.uiautomator:uiautomator:2.4.0"
    )

    // Android loads the test APK before the app APK in one class loader, so whatever both contain comes from the
    // test APK: unpatched cats jars, app classes, R ids. Mill packs all of these by default. Keep the suites and
    // test-only libraries. Jars the app already packs are matched by artifact and version. R.jar goes too,
    // the suites use no resources.
    override def androidPackagedDeps: T[Seq[PathRef]] = Task {
      def artifact(jar: PathRef) = jar.path.segments.toSeq.takeRight(3)
      val inApp                  = (app.androidResolvedRunMvnDeps() ++ app.androidRepackagedDeps()).map(artifact).toSet
      super.androidPackagedDeps().filterNot(jar => inApp(artifact(jar)) || jar == androidProcessedResources())
    }

    override def androidPackagedClassfiles: T[Seq[PathRef]] = Task {
      os.walk(compile().classes.path).filter(_.ext == "class").map(PathRef(_))
    }
  }
}
