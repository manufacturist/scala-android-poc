# Mill build output (compiled classes, APKs, patched jars, generated layout bindings)
out/

# BSP connection file. Generated by IntelliJ or `./mill --bsp-install` and holds machine-specific paths
.bsp/

# IDE state
.idea/
*.iml
.metals/
.bloop/
.vscode/
.scala-build/

# Android build artifacts and local config
*.apk
*.aab
*.idsig
*.dex
local.properties
captures/
*.hprof

# Signing keys. Never commit these
*.jks
*.keystore

# Logs
*.log

# macOS
.DS_Store
